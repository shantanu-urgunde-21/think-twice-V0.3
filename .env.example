# Root-level .env — loaded by docker-compose for postgres service vars and image selection.
# Copy to .env at the project root on EC2, then fill in real values.

# --- Postgres container credentials ---
# Must match the DATABASE_URL in backend/.env
POSTGRES_USER=gameuser
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=game_theory_db

# --- Backend image ---
# Set to the GHCR SHA-tagged image pushed by CI:
#   BACKEND_IMAGE=ghcr.io/<your-github-username>/think-twice-backend:<commit-sha>
# Locally (after docker build -t think-twice-backend-local ./backend):
#   BACKEND_IMAGE=think-twice-backend-local
BACKEND_IMAGE=think-twice-backend-local