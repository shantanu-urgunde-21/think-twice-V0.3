# Copy this file to .env in the same directory.
# The app falls back to safe defaults if these values are not set.

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
SECRET_KEY=change-this-to-a-random-32-char-value
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
MAX_PLAYERS=40

# --- DATABASE_URL variants ---
# Local SQLite (no postgres container needed):
DATABASE_URL=sqlite:///./game_theory_db.db

# Local docker-compose (postgres container, host = service name "postgres"):
# DATABASE_URL=postgresql://gameuser:change-me-strong-password@postgres:5432/game_theory_db

# EC2 + RDS (production — keep this in the EC2 .env, never commit):
# DATABASE_URL=postgresql://<user>:<password>@<rds-endpoint>:5432/<db-name>

# EC2 + docker-compose postgres container (dev/staging on EC2, no RDS):
# DATABASE_URL=postgresql://gameuser:change-me-strong-password@postgres:5432/game_theory_db

# --- EC2 production overrides ---
# FRONTEND_URL=http://<elastic-ip>   (or https://<domain> once TLS is set up)
# CORS_ORIGINS=http://<elastic-ip>
