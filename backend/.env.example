# Copy this file to .env in the same directory for local development.
# The app will also fall back to safe defaults if these values are not set.

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
SECRET_KEY=change-this-to-a-random-32-char-value
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
DATABASE_URL=sqlite:///./game_theory_db.db
# For EC2 + RDS, use:
# DATABASE_URL=postgresql://postgres:<password>@<rds-endpoint>:5432/<db-name>
MAX_PLAYERS=40
